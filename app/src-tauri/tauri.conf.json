{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Levelset",
  "version": "0.1.0",
  "identifier": "app.levelset.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Levelset",
        "width": 1440,
        "height": 900,
        "minWidth": 1180,
        "minHeight": 720,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "publisher": "Levelset Contributors (placeholder)",
    "copyright": "MIT License. Includes day-trader-skill (MIT) by Jake Schincariol.",
    "category": "Finance",
    "shortDescription": "Desktop cockpit for the day-trader-skill pack",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English", "Spanish"],
        "startMenuFolder": "Levelset",
        "installerIcon": "icons/icon.ico"
      }
    }
  }
}
